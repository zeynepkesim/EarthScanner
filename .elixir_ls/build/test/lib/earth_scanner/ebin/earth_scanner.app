{application,earth_scanner,
    [{modules,
         ['Elixir.EarthScanner','Elixir.EarthScanner.Accounts',
          'Elixir.EarthScanner.Accounts.User',
          'Elixir.EarthScanner.Application','Elixir.EarthScanner.DataCase',
          'Elixir.EarthScanner.Mailer','Elixir.EarthScanner.Repo',
          'Elixir.EarthScannerWeb','Elixir.EarthScannerWeb.ConnCase',
          'Elixir.EarthScannerWeb.CoreComponents',
          'Elixir.EarthScannerWeb.Endpoint',
          'Elixir.EarthScannerWeb.ErrorHTML',
          'Elixir.EarthScannerWeb.ErrorJSON',
          'Elixir.EarthScannerWeb.FetchCurrentUser',
          'Elixir.EarthScannerWeb.Gettext','Elixir.EarthScannerWeb.Layouts',
          'Elixir.EarthScannerWeb.PageController',
          'Elixir.EarthScannerWeb.PageHTML',
          'Elixir.EarthScannerWeb.ProfileController',
          'Elixir.EarthScannerWeb.ProfileHTML',
          'Elixir.EarthScannerWeb.Router',
          'Elixir.EarthScannerWeb.SessionController',
          'Elixir.EarthScannerWeb.SessionHTML',
          'Elixir.EarthScannerWeb.Telemetry',
          'Elixir.EarthScannerWeb.UserRegistrationController',
          'Elixir.EarthScannerWeb.UserRegistrationHTML']},
     {compile_env,
         [{earth_scanner,
              ['Elixir.EarthScannerWeb.Endpoint',code_reloader],
              error},
          {earth_scanner,
              ['Elixir.EarthScannerWeb.Endpoint',debug_errors],
              error},
          {earth_scanner,['Elixir.EarthScannerWeb.Endpoint',force_ssl],error},
          {earth_scanner,['Elixir.EarthScannerWeb.Gettext'],error},
          {earth_scanner,[dev_routes],error}]},
     {optional_applications,[]},
     {applications,
         [kernel,stdlib,elixir,logger,runtime_tools,phoenix,phoenix_ecto,
          ecto_sql,postgrex,phoenix_html,phoenix_live_view,lazy_html,
          phoenix_live_dashboard,swoosh,req,telemetry_metrics,
          telemetry_poller,gettext,jason,dns_cluster,bandit,white_bread,hound,
          gherkin,pbkdf2_elixir]},
     {description,"earth_scanner"},
     {registered,[]},
     {vsn,"0.1.0"},
     {mod,{'Elixir.EarthScanner.Application',[]}}]}.
