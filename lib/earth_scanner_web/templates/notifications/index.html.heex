<Layouts.app flash={@flash} current_scope="user">
  <h1 class="text-2xl font-semibold">Notifications</h1>
  <div class="mt-4">
    <%= if @reminders == [] do %>
      <p>No notifications at this time.</p>
    <% else %>
      <ul class="space-y-3">
        <%= for r <- @reminders do %>
          <li class="p-3 border rounded">
            <div class="font-semibold">{r.trip.source_city} → {r.trip.destination_city}</div>

            <div>Instance date: {r.instance.date}</div>

            <div>Departs at: {r.departure}</div>

            <div class="mt-2 text-sm text-gray-700">
              You purchased this trip. Reminder: departs within 24 hours.
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</Layouts.app>
