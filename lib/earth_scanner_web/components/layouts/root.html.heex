<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="EarthScanner" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>

    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>

  <body>
    <header class="w-full border-b border-base-200 sticky top-0 z-20 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/60">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href={~p"/"} class="font-semibold">EarthScanner</a>
        <%!-- FR-19: Account access links visible to all users, adapting to logged-in/logged-out state --%>
        <div class="flex items-center gap-3">
          <%= if assigns[:current_user] do %>
            <div class="relative">
              <a
                href={~p"/notifications"}
                class="p-2 rounded hover:bg-gray-100"
                aria-label="Notifications"
              >
                <.icon name="hero-bell" class="w-5 h-5" />
              </a>
              <%= if assigns[:notification_count] && assigns[:notification_count] > 0 do %>
                <span class="absolute -top-0.5 -right-0.5 inline-flex items-center justify-center px-1.5 py-0.5 text-xs font-semibold text-white bg-red-600 rounded-full">
                  {assigns.notification_count}
                </span>
              <% end %>
            </div>

            <span class="text-sm opacity-80">
              Logged in as {assigns.current_user.email}
              <%= if assigns.current_user.role do %>
                ({assigns.current_user.role})
              <% end %>
            </span>
            <a href={~p"/profile"} class="text-sm font-medium">Profile</a>
            <%= unless assigns.current_user.role == "admin" do %>
              <a
                href={~p"/my-trips"}
                class="text-sm font-medium text-blue-700 hover:underline"
              >
                My Trips
              </a>
            <% end %>

            <%= if assigns.current_user.role == "admin" do %>
              <a
                href={~p"/admin/my-trips"}
                class="text-sm font-medium text-indigo-700 hover:underline"
              >
                Admin Trips
              </a>
            <% end %>

            <form action={~p"/users/logout"} method="post">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <input type="hidden" name="_method" value="delete" />
              <button class="rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white">
                Log out
              </button>
            </form>
          <% else %>
            <a href={~p"/users/login"} class="text-sm font-medium text-indigo-600">Log in</a>
            <a href={~p"/users/register"} class="text-sm font-medium">Register</a>
          <% end %>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-4xl mt-4 px-4">
      <%= if Phoenix.Flash.get(@flash, :info) do %>
        <div class="mb-4 rounded-md bg-emerald-100 px-4 py-2 text-emerald-800 font-medium border border-emerald-200">
          {Phoenix.Flash.get(@flash, :info)}
        </div>
      <% end %>

      <%= if Phoenix.Flash.get(@flash, :error) do %>
        <div class="mb-4 rounded-md bg-red-100 px-4 py-2 text-red-800 font-medium border border-red-200">
          {Phoenix.Flash.get(@flash, :error)}
        </div>
      <% end %>
      {@inner_content}
    </div>
  </body>
</html>
