<Layouts.flash_group flash={@flash} />
<div class="min-h-screen flex items-center justify-center px-6 py-12 bg-white">
  <div class="max-w-2xl text-center">
    <h1 class="text-3xl font-semibold text-slate-900 mb-4">Explore upcoming trips</h1>

    <p class="text-slate-600 mb-8">Find and book upcoming trips in one place.</p>

    <%= if @current_user && @current_user.role != "admin" do %>
      <a
        href={~p"/trips"}
        class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 text-sm font-medium text-white hover:bg-blue-700"
      >
        View Trips
      </a>
    <% else %>
      <%= if @current_user && @current_user.role == "admin" do %>
        <a
          href={~p"/admin/trips"}
          class="inline-flex items-center rounded-lg bg-gray-600 px-6 py-3 text-sm font-medium text-white hover:bg-gray-700"
        >
          Admin Trips
        </a>
      <% else %>
        <a
          href={~p"/users/login"}
          class="inline-flex items-center rounded-lg bg-green-600 px-6 py-3 text-sm font-medium text-white hover:bg-green-700"
        >
          Log in to view trips
        </a>
      <% end %>
    <% end %>
    <%= if @current_user && @current_user.role == "user" do %>
      <div class="mt-6 p-4 border rounded-lg bg-gray-50">
        <h2 class="text-lg font-semibold text-indigo-700 mb-3">Search Trips</h2>

        <form action={~p"/search/results"} method="get" class="flex flex-col gap-3">
          <div>
            <label class="block text-sm font-medium mb-1">Source</label>
            <input
              type="text"
              name="source"
              class="w-full px-3 py-2 border rounded"
              placeholder="Enter source city"
              required
            />
          </div>

          <div>
            <label class="block text-sm font-medium mb-1">Destination</label>
            <input
              type="text"
              name="destination"
              class="w-full px-3 py-2 border rounded"
              placeholder="Enter destination city"
              required
            />
          </div>

          <button
            type="submit"
            class="mt-2 bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700"
          >
            Search
          </button>
        </form>
      </div>
    <% end %>
  </div>
</div>
