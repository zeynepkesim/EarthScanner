<Layouts.app flash={@flash}>
  <div class="relative min-h-screen">
    <div class="fixed inset-0 -z-10">
      <div class="aurora-background h-full w-full">
        <div class="aurora-layer" aria-hidden="true"></div>
        
        <div class="aurora-layer aurora-layer--accent" aria-hidden="true"></div>
        
        <div class="aurora-grid" aria-hidden="true"></div>
        
        <div class="aurora-noise" aria-hidden="true"></div>
      </div>
    </div>
    
    <div class="relative z-10 flex min-h-screen items-center justify-center px-6 py-12">
      <div class="max-w-2xl text-center rounded-3xl border border-white/10 bg-white/90 p-10 shadow-2xl shadow-emerald-900/20 backdrop-blur">
        <h1 class="mb-4 text-3xl font-semibold text-slate-900">Explore upcoming trips</h1>
        
        <p class="mb-8 text-slate-600">Find and book upcoming trips in one place.</p>
        
        <%= if @current_user && @current_user.role != "admin" do %>
          <a
            href={~p"/trips"}
            class="inline-flex items-center rounded-lg bg-blue-600 px-6 py-3 text-sm font-medium text-white hover:bg-blue-700"
          >
            View Trips
          </a>
        <% else %>
          <%= if @current_user && @current_user.role == "admin" do %>
            <a
              href={~p"/admin/trips"}
              class="inline-flex items-center rounded-lg bg-gray-600 px-6 py-3 text-sm font-medium text-white hover:bg-gray-700"
            >
              Admin Trips
            </a>
          <% else %>
            <a
              href={~p"/users/login"}
              class="inline-flex items-center rounded-lg bg-green-600 px-6 py-3 text-sm font-medium text-white hover:bg-green-700"
            >
              Log in to view trips
            </a>
          <% end %>
        <% end %>
         <%!-- FR-19: Account access links always visible on homepage --%>
        <div class="mt-12 flex flex-col items-center gap-4 border-t border-slate-200 pt-8">
          <p class="text-sm text-slate-500">Account</p>
          
          <div class="flex gap-4">
            <%= if @current_user do %>
              <a
                href={~p"/profile"}
                class="text-sm font-medium text-indigo-600 hover:text-indigo-700"
              >
                Account Details
              </a>
              <form action={~p"/users/logout"} method="post" class="inline">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="_method" value="delete" />
                <button class="text-sm font-medium text-indigo-600 hover:text-indigo-700">
                  Log Out
                </button>
              </form>
            <% else %>
              <a
                href={~p"/users/login"}
                class="text-sm font-medium text-indigo-600 hover:text-indigo-700"
              >
                Log In
              </a>
              <a
                href={~p"/users/register"}
                class="text-sm font-medium text-indigo-600 hover:text-indigo-700"
              >
                Register
              </a>
            <% end %>
          </div>
        </div>
        
        <%= if @current_user && @current_user.role == "user" do %>
          <div class="mt-6 rounded-lg border bg-gray-50 p-4">
            <h2 class="mb-3 text-lg font-semibold text-indigo-700">Search Trips</h2>
            
            <form action={~p"/search/results"} method="get" class="flex flex-col gap-3">
              <div>
                <label class="mb-1 block text-sm font-medium">Source</label>
                <input
                  type="text"
                  name="source"
                  class="w-full rounded border px-3 py-2"
                  placeholder="Enter source city"
                  required
                />
              </div>
              
              <div>
                <label class="mb-1 block text-sm font-medium">Destination</label>
                <input
                  type="text"
                  name="destination"
                  class="w-full rounded border px-3 py-2"
                  placeholder="Enter destination city"
                  required
                />
              </div>
              
              <button
                type="submit"
                class="mt-2 rounded bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700"
              >
                Search
              </button>
            </form>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
