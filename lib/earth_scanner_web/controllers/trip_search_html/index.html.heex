<h1>Search Results</h1>

<form method="get" action={~p"/search/results"} class="mb-4">
  <%= for {k, v} <- @filters do %>
    <input type="hidden" name={k} value={v} />
  <% end %>
  <label class="font-medium">Sort by:</label>
  <select name="sort" class="border rounded-md px-2 py-1 ml-2" onchange="this.form.submit()">
    <option value="">Default (Departure time)</option>

    <option value="price_asc" selected={@filters["sort"] == "price_asc"}>Price ↑</option>

    <option value="price_desc" selected={@filters["sort"] == "price_desc"}>Price ↓</option>

    <option value="co2_asc" selected={@filters["sort"] == "co2_asc"}>CO₂ ↑</option>

    <option value="co2_desc" selected={@filters["sort"] == "co2_desc"}>CO₂ ↓</option>

    <option value="duration_asc" selected={@filters["sort"] == "duration_asc"}>Duration ↑</option>

    <option value="duration_desc" selected={@filters["sort"] == "duration_desc"}>
      Duration ↓
    </option>
  </select>
</form>

<% filter_labels = %{
  "min_price" => "Min Price",
  "max_price" => "Max Price",
  "min_duration" => "Min Duration",
  "max_duration" => "Max Duration",
  "min_co2" => "Min CO₂",
  "max_co2" => "Max CO₂",
  "min_departure" => "Min Departure",
  "max_departure" => "Max Departure",
  "min_arrival" => "Min Arrival",
  "max_arrival" => "Max Arrival"
} %>
<% active_filters =
  @filters
  |> Enum.filter(fn {k, v} -> k in Map.keys(filter_labels) and v not in [nil, ""] end) %>
<%= if active_filters != [] do %>
  <div class="my-4 flex flex-wrap gap-2">
    <%= for {key, value} <- active_filters do %>
      <span class="inline-flex items-center px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">
        {filter_labels[key]}: {value} <% new_filters =
          Map.put(@filters, key, nil) |> Enum.reject(fn {_, v} -> v in [nil, ""] end) %>
        <a
          href={~p"/search/results?#{URI.encode_query(new_filters)}"}
          class="ml-2 text-blue-600 hover:text-blue-800 font-bold"
        >
          ×
        </a>
      </span>
    <% end %>
  </div>
<% end %>

<%= if @purchase_summary && MapSet.size(@purchase_summary.trip_ids) > 0 do %>
  <div
    id="search-results-legend"
    class="mb-4 flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600"
  >
    <span class="font-semibold text-slate-800">Legend:</span>
    <span class="inline-flex items-center gap-1 text-slate-700">
      <span
        data-role="purchased-badge"
        class="rounded-full bg-indigo-50 px-2 py-1 text-xs font-semibold text-indigo-700"
      >
        Purchased
      </span>
      Already booked trip
    </span>
  </div>
<% end %>

<%= if @trips == [] do %>
  <p>No trips found yet (we will implement filtering & DB next).</p>
<% else %>

  <!-- FR-10: Top Picks section (fastest, cheapest, greenest) -->
  <h2 class="mt-4 mb-2 text-lg font-semibold">Top Picks</h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <%= if @top_trips && @top_trips.fastest do %>
      <.link
        navigate={~p"/trips/#{@top_trips.fastest.id}"}
        class="top-pick-card block p-4 rounded-lg border bg-sky-50 hover:bg-sky-100"
      >
        <p class="top-pick-label text-xs font-semibold text-sky-700 mb-1">Fastest</p>
        <p class="font-medium">
          <%= @top_trips.fastest.source_city %> → <%= @top_trips.fastest.destination_city %>
        </p>
        <p class="text-xs text-slate-600">
          Duration: <%= @top_trips.fastest.duration_minutes %> min
        </p>
      </.link>
    <% end %>

    <%= if @top_trips && @top_trips.cheapest do %>
      <.link
        navigate={~p"/trips/#{@top_trips.cheapest.id}"}
        class="top-pick-card block p-4 rounded-lg border bg-emerald-50 hover:bg-emerald-100"
      >
        <p class="top-pick-label text-xs font-semibold text-emerald-700 mb-1">Cheapest</p>
        <p class="font-medium">
          <%= @top_trips.cheapest.source_city %> → <%= @top_trips.cheapest.destination_city %>
        </p>
        <p class="text-xs text-slate-600">
          Price: €<%= @top_trips.cheapest.price %>
        </p>
      </.link>
    <% end %>

    <%= if @top_trips && @top_trips.greenest do %>
      <.link
        navigate={~p"/trips/#{@top_trips.greenest.id}"}
        class="top-pick-card block p-4 rounded-lg border bg-lime-50 hover:bg-lime-100"
      >
        <p class="top-pick-label text-xs font-semibold text-lime-700 mb-1">Greenest</p>
        <p class="font-medium">
          <%= @top_trips.greenest.source_city %> → <%= @top_trips.greenest.destination_city %>
        </p>
        <p class="text-xs text-slate-600">
          CO₂: <%= @top_trips.greenest.co2_level %>
        </p>
      </.link>
    <% end %>
  </div>

  <ul class="space-y-4">
    <%= for trip <- @trips do %>
      <li
        class={[
          "rounded-lg border border-slate-200 p-4 shadow-sm",
          MapSet.member?(@sold_out_trip_ids || MapSet.new(), trip.id) && "bg-gray-100 opacity-70"
        ]}
      >
        <strong>{trip.source_city} → {trip.destination_city}</strong> <br />
        Mode: {trip.transport_mode}<br /> Price: {trip.price}<br />
        CO₂: {trip.co2_level} g/km<br /> Departs: {trip.departure_time}<br />
        Arrives: {trip.arrival_time}<br />
        <span
          :if={MapSet.member?(@purchase_summary.trip_ids, trip.id)}
          class="text-sm font-semibold text-green-700"
        >
          <span
            data-role="purchased-badge"
            class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700"
          >
            Purchased
          </span>
        </span>
        <span
          :if={!MapSet.member?(@purchase_summary.trip_ids, trip.id)}
          class="text-sm text-slate-500"
        >
          Not purchased yet
        </span>
        <% first_available_instance =
          Enum.find(trip.instances, fn instance -> instance.available_tickets > 0 end) %>
        <div class="mt-3 space-y-2 text-sm">
          <div :if={trip.instances != []}>
            <strong>Available dates:</strong>
            <%= for instance <- trip.instances do %>
              <div class="mt-1">
                {Calendar.strftime(instance.date, "%b %d, %Y")} — {instance.available_tickets} tickets left
                <span
                  :if={MapSet.member?(@purchase_summary.instance_ids, instance.id)}
                  class="text-green-600"
                >
                  (Already purchased)
                </span>
                <span :if={instance.available_tickets == 0} class="text-slate-500">
                  (Sold out)
                </span>
                <.form
                  :if={
                    MapSet.member?(@purchase_summary.instance_ids, instance.id) &&
                      instance.available_tickets >= 0
                  }
                  for={%{}}
                  method="post"
                  action={~p"/trips/#{trip.id}/purchase"}
                  class="mt-1 inline-block"
                >
                  <input type="hidden" name="_method" value="delete" />
                  <input type="hidden" name="trip_instance_id" value={instance.id} />
                  <input type="hidden" name="redirect_to" value={@return_path} />
                  <button
                    type="submit"
                    class="text-xs font-semibold text-red-600 hover:text-red-800"
                    data-confirm="Refund this seat?"
                  >
                    Refund seat
                  </button>
                </.form>
              </div>
            <% end %>
          </div>

          <.form
            :if={first_available_instance}
            for={%{}}
            method="post"
            action={~p"/trips/#{trip.id}/purchase"}
            class="mt-2"
          >
            <input type="hidden" name="trip_instance_id" value={first_available_instance.id} />
            <input type="hidden" name="redirect_to" value={@return_path} />
            <button
              type="submit"
              class="inline-flex items-center rounded-md bg-blue-600 px-3 py-1 text-sm font-semibold text-white hover:bg-blue-700"
              data-confirm="Confirm purchase?"
            >
              Purchase next available date
            </button>
          </.form>

          <!-- FR-15: sold-out state with disabled button and tooltip -->
          <div :if={!first_available_instance} class="mt-2 flex items-center gap-2">
            <button
              type="button"
              class="inline-flex items-center rounded-md bg-gray-300 px-3 py-1 text-sm font-semibold text-gray-600 cursor-not-allowed"
              disabled
              title="This trip is sold out and cannot be purchased"
              data-role="sold-out-button"
            >
              Sold out
            </button>

            <p class="text-slate-500">
              All future dates are sold out.
            </p>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<hr class="my-4" />
<div class="flex justify-between items-center">
  <%= if @page > 1 do %>
    <a
      class="px-3 py-1 bg-gray-200 hover:bg-gray-300 rounded-md"
      href={
        ~p"/search/results?#{URI.encode_query(Map.put(@filters, "page", Integer.to_string(@page - 1)))}"
      }
    >
      ← Previous
    </a>
  <% else %>
    <span></span>
  <% end %>

  <%= if @page * @per_page < @total do %>
    <a
      class="px-3 py-1 bg-gray-200 hover:bg-gray-300 rounded-md"
      href={
        ~p"/search/results?#{URI.encode_query(Map.put(@filters, "page", Integer.to_string(@page + 1)))}"
      }
    >
      Next →
    </a>
  <% else %>
    <span></span>
  <% end %>
</div>

<p>
  <button
    type="submit"
    class="mt-4 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium"
  >
    <a href={~p"/search"}>New Search</a>
  </button>
</p>
