<div class="min-h-screen bg-white px-6 py-8">
  <div class="mx-auto max-w-xl">
    <h1 class="text-2xl font-semibold text-slate-900 mb-6">Edit trip date</h1>
    <p class="text-sm text-slate-600 mb-4">
      Trip date for {@instance.trip.source_city} → {@instance.trip.destination_city}.
    </p>

    <.form
      for={@form}
      action={~p"/admin/trips/#{@instance.trip_id}/instances/#{@instance.id}"}
      class="space-y-4"
      id="trip-instance-form"
    >
      <.input field={@form[:date]} type="date" label="Date" />
      <.input
        field={@form[:available_tickets]}
        type="number"
        label="Available tickets"
      />
      <div class="flex items-center justify-between mt-6">
        <a
          href={~p"/admin/trips"}
          class="text-sm text-slate-600 hover:underline"
        >
          Cancel
        </a>
        <button
          type="submit"
          class="inline-flex items-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700"
        >
          Save
        </button>
      </div>
    </.form>
  </div>
</div>
