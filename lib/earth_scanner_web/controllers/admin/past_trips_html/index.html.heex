<Layouts.app flash={@flash} current_scope={:admin}>
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Past Trips</h1>

        <p class="mt-1 text-sm text-gray-500">
          Review completed excursions and their performance
        </p>
      </div>

      <div class="flex gap-2">
        <.link
          href={~p"/admin/trips"}
          class="px-4 py-2 rounded-lg bg-gray-600 text-white text-sm font-medium hover:bg-gray-700 transition-colors"
        >
          All Trips
        </.link>
        <.link
          href={~p"/admin/future-trips"}
          class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors"
        >
          View Future Trips
        </.link>
      </div>

      <div class="px-4 py-2 bg-blue-50 rounded-lg">
        <div class="text-xs text-gray-500 uppercase tracking-wide">Total</div>

        <div class="text-2xl font-bold text-blue-600">{length(@excursions)}</div>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <%= if @excursions == [] do %>
      <div class="rounded-md border border-dashed border-gray-200 p-6 text-center text-gray-600">
        No past trips yet.
      </div>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
        <%= for trip <- @excursions do %>
          <article
            id={"trip-#{trip.id}"}
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 p-5 bg-white border-b border-gray-200 last:border-b-0 hover:bg-gray-50 transition-all duration-200"
          >
            <div class="flex items-center gap-5">
              <%= if trip.picture_url do %>
                <img
                  src={trip.picture_url}
                  alt="trip image"
                  class="w-32 h-24 rounded-lg object-cover shadow-md"
                />
              <% else %>
                <div class="w-32 h-24 rounded-lg bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center text-xs text-gray-400 border border-gray-200">
                  <svg
                    class="w-8 h-8 text-gray-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                    >
                    </path>
                  </svg>
                </div>
              <% end %>

              <div>
                <div class="flex items-center gap-2 mb-2">
                  <div class="px-2 py-0.5 bg-gray-100 rounded text-xs font-medium text-gray-600">
                    {Calendar.strftime(trip.departure_time, "%b %d, %Y")}
                  </div>

                  <div class="text-xs text-gray-400">
                    {Calendar.strftime(trip.departure_time, "%H:%M")}
                  </div>
                </div>

                <div class="font-bold text-gray-900 text-xl mb-1">
                  {trip.source_city} <span class="text-blue-500">→</span> {trip.destination_city}
                </div>

                <div class="flex items-center gap-3 text-sm text-gray-500">
                  <span class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
                      >
                      </path>
                    </svg>
                    {trip.available_tickets} tickets
                  </span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="px-4 py-2 rounded-full bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200">
                <div class="text-xs text-green-600 font-medium">
                  ${Decimal.to_string(trip.price)}
                </div>
              </div>

              <.link
                href={~p"/admin/past-trips/#{trip.id}"}
                class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors shadow-sm"
              >
                View Details
              </.link>
              <form action={~p"/trips/#{trip.id}"} method="post" class="inline">
                <input type="hidden" name="_method" value="delete" />
                <button class="px-4 py-2 rounded-lg bg-red-600 text-white text-sm font-medium hover:bg-red-700 transition-colors shadow-sm">
                  Delete
                </button>
              </form>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </div>
</Layouts.app>
