<Layouts.app flash={@flash} current_scope={:admin}>
  <div class="mb-6">
    <.link
      href={~p"/admin/past-trips"}
      class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-4"
    >
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7">
        </path>
      </svg>
      Back to Past Trips
    </.link>
    <h1 class="text-3xl font-bold text-gray-900">Trip Details</h1>

    <p class="mt-1 text-sm text-gray-500">Complete excursion information and statistics</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
        <%= if @trip.picture_url do %>
          <img
            src={@trip.picture_url}
            alt="trip image"
            class="w-full h-64 object-cover rounded-lg mb-6"
          />
        <% end %>

        <div class="flex items-center gap-2 mb-3">
          <div class="px-3 py-1 bg-gray-100 rounded-full text-xs font-medium text-gray-600">
            Completed
          </div>
        </div>

        <h2 class="text-2xl font-bold text-gray-900 mb-4">
          {@trip.source_city} <span class="text-blue-500">→</span> {@trip.destination_city}
        </h2>

        <div class="grid grid-cols-2 gap-4 p-4 bg-gray-50 rounded-lg">
          <div>
            <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Departure</div>

            <div class="font-semibold text-gray-900">
              {Calendar.strftime(@trip.departure_time, "%b %d, %Y")}
            </div>

            <div class="text-sm text-gray-600">
              {Calendar.strftime(@trip.departure_time, "%H:%M")}
            </div>
          </div>

          <div>
            <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Arrival</div>

            <div class="font-semibold text-gray-900">
              {Calendar.strftime(@trip.arrival_time, "%b %d, %Y")}
            </div>

            <div class="text-sm text-gray-600">
              {Calendar.strftime(@trip.arrival_time, "%H:%M")}
            </div>
          </div>
        </div>
      </div>
    </div>

    <aside class="space-y-6">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
        <div class="text-xs text-gray-500 uppercase tracking-wide mb-2">Pricing</div>

        <div class="text-3xl font-bold text-gray-900 mb-6">${Decimal.to_string(@trip.price)}</div>

        <div class="mb-6">
          <div class="text-xs text-gray-500 uppercase tracking-wide mb-2">Available Tickets</div>

          <div class="text-2xl font-semibold text-gray-700">{@trip.available_tickets}</div>
        </div>

        <div class="space-y-3 pt-6 border-t border-gray-200">
          <.link
            href={~p"/trips/#{@trip.id}/edit"}
            class="block w-full px-4 py-3 text-center rounded-lg bg-amber-100 text-amber-900 font-medium hover:bg-amber-200 transition-colors"
          >
            Edit Trip
          </.link>
          <form action={~p"/trips/#{@trip.id}"} method="post">
            <input type="hidden" name="_method" value="delete" />
            <button class="w-full px-4 py-3 rounded-lg bg-red-600 text-white font-medium hover:bg-red-700 transition-colors shadow-sm">
              Delete Trip
            </button>
          </form>
        </div>
      </div>
    </aside>
  </div>
</Layouts.app>
