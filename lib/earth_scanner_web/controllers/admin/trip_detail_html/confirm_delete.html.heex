<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="bg-white shadow-lg rounded-lg overflow-hidden">
    <!-- Warning Header -->
    <div class="bg-red-600 text-white px-6 py-4">
      <div class="flex items-center gap-3">
        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
            clip-rule="evenodd"
          />
        </svg>
        <h1 class="text-2xl font-bold">Confirm Trip Deletion</h1>
      </div>
    </div>

    <div class="p-6">
      <!-- Warning Message -->
      <div class="bg-red-50 border-l-4 border-red-600 p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                clip-rule="evenodd"
              />
            </svg>
          </div>

          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">Warning: This trip has sold tickets!</h3>

            <div class="mt-2 text-sm text-red-700">
              <p>
                Deleting this trip will also remove all purchased tickets and may impact users who have already booked.
                This action cannot be undone.
              </p>
            </div>
          </div>
        </div>
      </div>
      <!-- Trip Details Summary -->
      <div class="bg-gray-50 rounded-lg p-4 mb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Trip Details</h2>

        <dl class="space-y-2">
          <div class="flex justify-between">
            <dt class="text-gray-600">Route:</dt>

            <dd class="font-medium text-gray-900">
              {@trip.source_city} → {@trip.destination_city}
            </dd>
          </div>

          <div class="flex justify-between">
            <dt class="text-gray-600">Transportation:</dt>

            <dd class="font-medium text-gray-900 capitalize">{@trip.transport_mode}</dd>
          </div>

          <div class="flex justify-between">
            <dt class="text-gray-600">Price:</dt>

            <dd class="font-medium text-gray-900">${@trip.price}</dd>
          </div>

          <div class="flex justify-between">
            <dt class="text-gray-600">Scheduled Dates:</dt>

            <dd class="font-medium text-gray-900">{length(@trip.instances)} date(s)</dd>
          </div>
        </dl>
      </div>
      <!-- Action Buttons -->
      <div class="flex gap-4">
        <.link
          navigate={~p"/admin/trips/#{@trip.id}"}
          class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium py-3 px-6 rounded-lg text-center transition-colors"
        >
          Cancel
        </.link>
        <.link
          href={~p"/admin/trips/#{@trip.id}/force-delete"}
          method="post"
          data-confirm="Are you absolutely sure? This will permanently delete the trip and all associated tickets."
          class="flex-1 bg-red-600 hover:bg-red-700 text-white font-medium py-3 px-6 rounded-lg text-center transition-colors"
        >
          Yes, Delete Anyway
        </.link>
      </div>

      <p class="mt-6 text-sm text-gray-500 text-center">
        If you're not sure, click Cancel and contact affected users before proceeding.
      </p>
    </div>
  </div>
</div>
