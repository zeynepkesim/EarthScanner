<Layouts.flash_group flash={@flash} />
<div class="min-h-screen bg-slate-100 px-4 py-8">
  <div class="mx-auto max-w-4xl space-y-6">
    <div class="flex items-center justify-between text-sm">
      <.link
        navigate={~p"/trips"}
        class="text-slate-600 hover:text-slate-900"
      >
        ← Back to all trips
      </.link>
      <span
        :if={MapSet.member?(@purchase_summary.trip_ids, @trip.id)}
        class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-600"
      >
        Purchased
      </span>
    </div>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase text-slate-500">
        {String.capitalize(@trip.transport_mode)} trip
      </p>
      <h1 class="mt-2 text-3xl font-bold text-slate-900">
        {@trip.source_city} → {@trip.destination_city}
      </h1>
      <p class="mt-1 text-sm text-slate-600">
        Departure {@trip.departure_time} • Arrival {@trip.arrival_time}
      </p>
      <dl class="mt-4 grid gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-slate-100 p-3">
          <dt class="text-xs uppercase text-slate-500">Duration</dt>
          <dd class="text-lg font-semibold text-slate-800">{@trip.duration_minutes} min</dd>
        </div>
        <div class="rounded-lg border border-slate-100 p-3">
          <dt class="text-xs uppercase text-slate-500">Price</dt>
          <dd class="text-lg font-semibold text-slate-800">€{@trip.price}</dd>
        </div>
        <div class="rounded-lg border border-slate-100 p-3">
          <dt class="text-xs uppercase text-slate-500">CO₂</dt>
          <dd class="text-lg font-semibold text-slate-800">{@trip.co2_level} g/km</dd>
        </div>
      </dl>
    </section>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-xl font-semibold text-slate-900">Available dates</h2>
      <p class="text-sm text-slate-600">Pick a date to reserve your seat.</p>
      <div
        :if={@trip.instances == []}
        class="mt-4 rounded-lg border border-dashed border-slate-200 p-5 text-center text-sm text-slate-500"
      >
        This trip does not have future dates yet.
      </div>
      <div :if={@trip.instances != []} class="mt-4 space-y-4">
        <div
          :for={instance <- @trip.instances}
          class="rounded-lg border border-slate-200 p-4"
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <p class="text-lg font-semibold text-slate-900">
                {Calendar.strftime(instance.date, "%A, %b %d")}
              </p>
              <p class="text-sm text-slate-500">{instance.available_tickets} tickets left</p>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
              <span
                :if={instance.available_tickets == 0}
                class="rounded-full bg-slate-100 px-3 py-1 text-slate-500"
              >
                Sold out
              </span>
              <span
                :if={MapSet.member?(@purchase_summary.instance_ids, instance.id)}
                class="rounded-full bg-indigo-50 px-3 py-1 text-indigo-600"
              >
                Purchased
              </span>
            </div>
          </div>
          <div class="mt-4">
            <.form
              :if={instance.available_tickets > 0}
              for={%{}}
              method="post"
              action={~p"/trips/#{@trip.id}/purchase"}
              class="flex flex-col gap-3 sm:flex-row"
            >
              <input type="hidden" name="trip_instance_id" value={instance.id} />
              <input type="hidden" name="redirect_to" value={@return_path} />
              <button
                type="submit"
                class="inline-flex flex-1 items-center justify-center rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-700"
                data-confirm="Confirm purchase?"
              >
                Purchase ticket
              </button>
            </.form>
            <p :if={instance.available_tickets == 0} class="text-sm text-slate-500">
              Try another date if you still need a seat.
            </p>
            <.form
              :if={MapSet.member?(@purchase_summary.instance_ids, instance.id)}
              for={%{}}
              method="post"
              action={~p"/trips/#{@trip.id}/purchase"}
              class="mt-3 flex flex-col sm:flex-row"
            >
              <input type="hidden" name="_method" value="delete" />
              <input type="hidden" name="trip_instance_id" value={instance.id} />
              <input type="hidden" name="redirect_to" value={@return_path} />
              <button
                type="submit"
                class="inline-flex flex-1 items-center justify-center rounded-lg border border-red-200 px-4 py-2 text-sm font-semibold text-red-600 hover:bg-red-50"
                data-confirm="Refund this purchase?"
              >
                Refund purchase
              </button>
            </.form>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
