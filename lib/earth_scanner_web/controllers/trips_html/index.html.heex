<Layouts.flash_group flash={@flash} />
<div class="min-h-screen bg-white px-6 py-8">
  <div class="mx-auto max-w-5xl">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-semibold text-slate-900">Upcoming trips</h1>

      <.link
        navigate={~p"/search"}
        class="inline-flex items-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700"
      >
        Search
      </.link>
    </div>

    <div :if={@trips == []} class="text-sm text-slate-500">
      There are no upcoming trips right now.
    </div>

    <div class="grid grid-cols-1 gap-4">
      <div :for={trip <- @trips} class="mb-6 rounded-xl border border-slate-200 p-4">
        <div class="flex justify-between items-start gap-4">
          <div class="flex-1">
            <p class="text-sm font-semibold text-slate-700">
              {trip.source_city} → {trip.destination_city}
            </p>

            <p class="mt-1 text-xs text-slate-500">
              {trip.transport_mode} • {trip.price}€ • CO₂: {trip.co2_level}
            </p>

            <p class="mt-1 text-xs text-slate-500">
              Departure: {trip.departure_time} • Arrival: {trip.arrival_time}
            </p>

            <p class="mt-1 text-xs text-slate-500">Duration: {trip.duration_minutes} minutes</p>

            <span
              :if={@purchase_summary && MapSet.member?(@purchase_summary.trip_ids, trip.id)}
              class="mt-2 inline-block rounded-full bg-indigo-600/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-indigo-600"
            >
              Purchased
            </span>
          </div>

          <div class="flex flex-col items-end gap-2">
            <img
              :if={trip.picture_url}
              src={trip.picture_url}
              alt="Trip picture"
              class="h-16 w-24 rounded-md object-cover"
            />
            <.link
              navigate={~p"/trips/#{trip.id}"}
              class="text-xs font-semibold text-sky-600 hover:text-sky-800"
            >
              View details →
            </.link>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
