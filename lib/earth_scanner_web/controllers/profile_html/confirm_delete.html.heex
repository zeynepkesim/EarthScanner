<div class="max-w-lg mx-auto space-y-6">
  <h1 class="text-2xl font-semibold">Delete account</h1>
  <p class="text-sm text-red-600">
    This action is irreversible. Your account and associated data will be permanently removed.
  </p>

  <.simple_form for={@form} id="delete-account-form" method="post" action={~p"/users/delete"}>
    <.input
      field={@form[:password]}
      type="password"
      label="Confirm your password"
      placeholder="••••••••"
      required
    />
    <div class="flex items-center space-x-2">
      <input
        type="checkbox"
        name="delete[confirm]"
        value="yes"
        id="confirm"
        class="rounded border-gray-300"
      />
      <label for="confirm" class="text-sm">I understand this action cannot be undone.</label>
    </div>

    <:actions>
      <.button class="bg-red-600 hover:bg-red-700">Delete my account</.button>
      <a href={~p"/profile"} class="ml-3 text-sm underline">Cancel</a>
    </:actions>
  </.simple_form>
</div>
