<.form :let={f} for={@changeset} action={~p"/admin/users"} method="post">
  <div><label>Username</label> <.input field={f[:username]} /></div>
  
  <div><label>Email</label> <.input field={f[:email]} /></div>
  
  <div><label>Phone Number</label> <.input field={f[:phone_number]} /></div>
  
  <div><label>Password</label> <.input field={f[:password]} type="password" /></div>
  
  <div>
    <label>Confirm Password</label> <.input field={f[:password_confirmation]} type="password" />
  </div>
   <button>Create Admin</button>
</.form>
