<div class="min-h-screen bg-gray-50 px-6 py-8">
  <div class="mx-auto max-w-3xl bg-white rounded-lg shadow-sm p-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Create New Trip</h1>

    <.form for={@form} action={~p"/admin/trips"} method="post" class="space-y-6">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Picture URL</label>
        <input
          type="text"
          name="trip[picture_url]"
          value={@form[:picture_url].value}
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900"
        />
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Transport Mode</label>
        <select
          name="trip[transport_mode]"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900"
        >
          <option value="">Select mode</option>

          <option value="plane">Plane</option>

          <option value="bus">Bus</option>

          <option value="train">Train</option>
        </select>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Source City</label>
          <input
            type="text"
            name="trip[source_city]"
            value={@form[:source_city].value}
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Destination City</label>
          <input
            type="text"
            name="trip[destination_city]"
            value={@form[:destination_city].value}
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Departure Time</label>
          <input
            type="datetime-local"
            name="trip[departure_time]"
            value={@form[:departure_time].value}
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Arrival Time</label>
          <input
            type="datetime-local"
            name="trip[arrival_time]"
            value={@form[:arrival_time].value}
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Price (€)</label>
          <input
            type="number"
            step="0.01"
            name="trip[price]"
            value={@form[:price].value}
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">CO₂ Level (kg)</label>
          <input
            type="number"
            name="trip[co2_level]"
            value={@form[:co2_level].value}
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Available Tickets</label>
          <input
            type="number"
            name="trip[available_tickets]"
            value={@form[:available_tickets].value}
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900"
          />
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Trip Dates (FR-36)</label>
        <p class="text-sm text-gray-500 mb-2">
          Enter one date per line, in format YYYY-MM-DD (e.g., 2025-12-20)
        </p>
        <textarea
          name="trip[dates]"
          rows="4"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent font-mono text-sm text-gray-900"
        ></textarea>
      </div>
      <div class="flex items-center justify-between pt-4 border-t">
        <a
          href={~p"/admin/trips"}
          class="text-sm text-gray-600 hover:text-gray-900 hover:underline"
        >
          ← Cancel
        </a>
        <button
          type="submit"
          class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors"
        >
          Create Trip
        </button>
      </div>
    </.form>
  </div>
</div>
