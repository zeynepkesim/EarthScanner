<div class="min-h-screen bg-white px-6 py-8">
  <div class="mx-auto max-w-5xl">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-semibold text-slate-900">Your future trips</h1>
      <div class="flex gap-2">
        <a
          href={~p"/admin/past-trips"}
          class="inline-flex items-center rounded-lg bg-gray-600 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700"
        >
          Past Trips
        </a>
        <a
          href={~p"/admin/future-trips"}
          class="inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"
        >
          Future Trips
        </a>
        <a
          href={~p"/admin/trips/new"}
          class="inline-flex items-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700"
        >
          New trip
        </a>
      </div>
    </div>

    <div :if={@trips == []} class="text-sm text-slate-500">You have no future trips yet.</div>

    <div :for={trip <- @trips} class="mb-6 rounded-xl border border-slate-200 p-4">
      <div class="flex justify-between items-start gap-4">
        <div class="flex-1">
          <p class="text-sm font-semibold text-slate-700">
            {trip.source_city} → {trip.destination_city}
          </p>

          <p class="mt-1 text-xs text-slate-500">
            {trip.transport_mode} • {trip.price}€ • CO₂: {trip.co2_level}
          </p>

          <p class="mt-1 text-xs text-slate-500">
            Departure: {trip.departure_time} • Arrival: {trip.arrival_time}
          </p>

          <p class="mt-1 text-xs text-slate-500">Duration: {trip.duration_minutes} minutes</p>
          <!-- FR-35: View Details Link -->
          <div class="mt-3">
            <.link
              navigate={~p"/admin/trips/#{trip.id}"}
              class="inline-flex items-center text-sm font-medium text-sky-600 hover:text-sky-800 hover:underline"
            >
              View Full Details →
            </.link>
          </div>
        </div>

        <img
          :if={trip.picture_url}
          src={trip.picture_url}
          alt="Trip picture"
          class="h-16 w-24 rounded-md object-cover"
        />
      </div>

      <div class="mt-4">
        <h2 class="text-xs font-semibold text-slate-600 uppercase tracking-wide">Details</h2>

        <ul class="mt-2 space-y-1">
          <li class="flex items-center justify-between text-sm text-slate-800">
            <span>Available Tickets: {trip.available_tickets}</span>
            <span class="space-x-2 text-xs">
              <.link
                navigate={~p"/admin/trips/#{trip.id}/edit"}
                class="text-sky-600 hover:underline"
              >
                Edit
              </.link>
              <form
                method="post"
                action={~p"/admin/trips/#{trip.id}"}
                class="inline"
              >
                <input type="hidden" name="_method" value="delete" />
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <button
                  type="submit"
                  class="text-red-600 hover:underline"
                  data-confirm="Are you sure you want to delete this trip?"
                >
                  Delete
                </button>
              </form>
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
