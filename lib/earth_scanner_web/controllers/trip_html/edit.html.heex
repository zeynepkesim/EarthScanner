<div class="min-h-screen bg-gray-50 px-6 py-8">
  <div class="mx-auto max-w-3xl bg-white rounded-lg shadow-sm p-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Edit Trip</h1>

    <.form for={@form} action={~p"/admin/trips/#{@trip.id}"} class="space-y-6" id="trip-form">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Picture URL</label>
        <.input field={@form[:picture_url]} type="text" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Transport Mode</label>
        <.input
          field={@form[:transport_mode]}
          type="select"
          options={[{"Plane", "plane"}, {"Bus", "bus"}, {"Train", "train"}]}
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Source City</label>
          <.input field={@form[:source_city]} type="text" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Destination City</label>
          <.input field={@form[:destination_city]} type="text" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Departure Time</label>
          <.input field={@form[:departure_time]} type="datetime-local" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Arrival Time</label>
          <.input field={@form[:arrival_time]} type="datetime-local" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Price (€)</label>
          <.input field={@form[:price]} type="number" step="0.01" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">CO₂ Level (kg)</label>
          <.input field={@form[:co2_level]} type="number" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Available Tickets</label>
          <.input field={@form[:available_tickets]} type="number" />
        </div>
      </div>

      <div class="flex items-center justify-between pt-4 border-t">
        <a
          href={~p"/admin/trips"}
          class="text-sm text-gray-600 hover:text-gray-900 hover:underline"
        >
          ← Cancel
        </a>
        <div class="flex gap-3">
          <button
            type="button"
            phx-click="delete"
            data-confirm="Are you sure?"
            onclick="fetch('/admin/trips/#{@trip.id}', {method: 'DELETE', headers: {'X-CSRF-Token': document.querySelector('input[name=_csrf_token]').value}}).then(() => window.location.href='/admin/trips')"
            class="px-6 py-3 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 focus:ring-4 focus:ring-red-300 transition-colors"
          >
            Delete Trip
          </button>
          <button
            type="submit"
            class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors"
          >
            Update Trip
          </button>
        </div>
      </div>
    </.form>
  </div>
</div>
